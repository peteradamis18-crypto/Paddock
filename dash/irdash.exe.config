<?xml version="1.0" encoding="utf-8"?>
<!-- W0-2: an exception on a background thread is logged by irdash (dash\src\log.cs Crash) and that thread ends; irdash and its tray
     stay up. Without this line .NET ends the whole program on any such exception, with no log line. tests\crash-handler-test.ps1 -->
<configuration>
  <runtime>
    <legacyUnhandledExceptionPolicy enabled="1" />
  </runtime>
</configuration>
